{
  "name": "gitview",
  "type": "module",
  "version": "0.52.0",
  "private": true,
  "packageManager": "pnpm@11.28.6",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Enlighten-Brasil/gitview.git"
  },
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "collect": "tsx scripts/collect.ts && tsx scripts/collect-github.ts && tsx scripts/collect-branches.ts && tsx scripts/collect-releases.ts && tsx scripts/collect-team.ts && tsx scripts/check-data.ts",
    "check:data": "tsx scripts/check-data.ts",
    "check:docs": "tsx scripts/check-docs.ts",
    "check:scrub": "tsx scripts/check-scrub.ts",
    "collect:branches": "tsx scripts/collect-branches.ts",
    "collect:github": "tsx scripts/collect-github.ts",
    "collect:releases": "tsx scripts/collect-releases.ts",
    "collect:team": "tsx scripts/collect-team.ts",
    "demo:shots": "tsx scripts/make-doc-shots.ts",
    "clean": "tsx scripts/clean.ts",
    "docs:dev": "pnpm --filter gitview-docs dev",
    "docs:build": "pnpm --filter gitview-docs build",
    "docs:preview": "pnpm --filter gitview-docs preview",
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "changeset": "changeset",
    "version:packages": "changeset version"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.140",
    "@nuxt/ui": "^4.11.3",
    "echarts": "^6.1.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.13",
    "vue-echarts": "^8.0.1",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.1",
    "eslint": "^10.12.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
