# gitview — configuração da máquina (este arquivo é o modelo; o real é o .env, gitignored)
#
# Na primeira execução o .env é criado automaticamente a partir deste arquivo
# (rodando pnpm dev, pnpm start ou qualquer coletor). Variáveis já definidas no
# shell têm prioridade sobre este arquivo.
#
# ⚠ O GITVIEW_GITHUB_TOKEN é o ÚNICO segredo daqui — nunca vá para o git.

# Client ID do OAuth App ou GitHub App com "Device Flow" habilitado
# (GitHub → Settings → Developer settings). É público por design: o fluxo de
# dispositivo não usa client secret. Começa com "Ov"/"Iv". Vazio = sem botão
# "Conectar com GitHub" (dá para colar um PAT ou usar o gh CLI autenticado).
GITVIEW_GITHUB_CLIENT_ID=Ov23li743Av3vHm0Al1T

# Token do GitHub (device flow, PAT classic ou colado na UI em /setup).
# Deixar vazio = usar o `gh auth token` se o GitHub CLI estiver logado.
GITVIEW_GITHUB_TOKEN=

# Org do GitHub usada como default no setup e na importação de times em /teams.
GITVIEW_GITHUB_ORG=

# Pasta com os clones dos repositórios. Vazio = padrão data/repos (criado pelo
# setup da UI). Pode ser absoluta ou relativa à raiz do projeto — caminho em
# Windows funciona com barra normal (C:/caminho/qualquer).
GITVIEW_REPOS_ROOT=

# Repos pré-selecionados no setup (CSV). Vazio = todos os não arquivados.
GITVIEW_DEFAULT_REPOS=

# Pastas a ignorar na descoberta de repos (CSV).
GITVIEW_EXCLUDE=

# Arquivos gerados ignorados nas métricas de linhas (CSV de globs, ex.:
# 'themes/**/vendor/**,docs/api/**'). ACRESCENTA à lista padrão de lockfiles
# e minificados (ver scripts/lib/config.ts). Só vale para commits novos —
# para reaplicar no histórico: pnpm clean && pnpm collect.
GITVIEW_EXCLUDE_PATHS=

# Porta do dev server (pnpm dev / pnpm start).
GITVIEW_PORT=5173

# Fuso canônico dos buckets de tempo (mês, dia, semana ISO, fim de semana,
# madrugada e heatmap). TODOS os agregados são calculados nele, nunca no
# relógio da máquina que coleta — assim o mesmo banco dá os mesmos buckets em
# qualquer máquina. Formato IANA (ex.: America/Sao_Paulo, Europe/Lisbon, UTC).
# Vazio → America/Sao_Paulo.
GITVIEW_TIMEZONE=America/Sao_Paulo
